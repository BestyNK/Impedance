<Window x:Class="impedance.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Калькулятор импеданса нагрузки" Height="900" Width="600"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Расчёт импеданса нагрузки по формуле:" 
                   FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" 
                   Margin="0,0,0,15"/>

        <!-- Formula Display -->
        <Border Grid.Row="1" BorderBrush="LightBlue" BorderThickness="1" 
                Background="AliceBlue" Padding="10" Width="320" Margin="0,0,0,20">
            <Image Source="/Resources/lagrida_latex_editor.png" Stretch="None" Height="89" VerticalAlignment="Center" HorizontalAlignment="Left" Width="538"/>
        </Border>

        <!-- Wave Impedance (Z0) -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,5">
            <TextBlock Text="Импеданс волны (Zв):" Width="150" VerticalAlignment="Center" FontSize="14"/>
            <TextBox x:Name="txtWaveImpedance" Width="120" Height="25" 
                     Text="50" HorizontalAlignment="Left"/>
            <TextBlock Text="Ом" VerticalAlignment="Center" Margin="5,0,0,0" FontSize="14"/>
        </StackPanel>

        <!-- K Parameter -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,5">
            <TextBlock Text="Коэффициент К:" Width="150" VerticalAlignment="Center" FontSize="14"/>
            <TextBox x:Name="txtK" Width="120" Height="25" 
                     Text="1" HorizontalAlignment="Left"/>
        </StackPanel>

        <!-- Wave Length -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,5">
            <TextBlock Text="Длина волны (λ):" Width="150" VerticalAlignment="Center" FontSize="14"/>
            <TextBox x:Name="txtWaveLength" Width="120" Height="25" 
                     Text="1" HorizontalAlignment="Left"/>
            <TextBlock Text="м" VerticalAlignment="Center" Margin="5,0,0,0" FontSize="14"/>
        </StackPanel>

        <!-- Zmin Parameter -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,5">
            <TextBlock Text="ΔZmin:" Width="150" VerticalAlignment="Center" FontSize="14"/>
            <TextBox x:Name="txtZmin" Width="120" Height="25" 
                     Text="0,25" HorizontalAlignment="Left"/>
            <TextBlock Text="м" VerticalAlignment="Center" Margin="5,0,0,0" FontSize="14"/>
        </StackPanel>

        <!-- Calculate Button -->
        <Button Grid.Row="6" x:Name="btnCalculate" Content="Посчитать" 
                Width="180" Height="35" Margin="0,20,0,10" 
                HorizontalAlignment="Center" Click="BtnCalculate_Click" FontSize="14"/>

        <!-- Result Display -->
        <Border Grid.Row="7" BorderBrush="LightGray" BorderThickness="1" 
                Padding="15" Margin="0,10,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="txtResult" Text="Результаты..." 
                           FontSize="14" TextWrapping="Wrap" FontFamily="Consolas"/>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>